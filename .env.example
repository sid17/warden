# Warden — example environment configuration.
#
# Copy to `.env` and fill in what you need. `.env` is gitignored. NOTHING here is
# required to run the test suite (it is hermetic) — these matter when you actually
# drive an agent. Every var is OPTIONAL with a sane default unless noted "REQUIRED".
# Precedence: OS/container env > .env.{WARDEN_ENV} > .env > field defaults.
#
# Test-only knobs (MOCK_WARDEN_*, WARDEN_TEST_POSTGRES_DSN, *_GATE_RUN_DIR) are
# intentionally NOT listed here — they configure the mock harness + test beds, not a
# real deployment.

# ── Core ──────────────────────────────────────────────────────────────────────
WARDEN_ENV=dev                       # dev | test | staging | prod   (alias: ENVIRONMENT)
# WARDEN_PROFILE=                     # profile module: bare name = built-in profiles/;
                                      #   dotted (my_pkg.my_product.real) = out-of-tree (docs/10)
# WARDEN_MODEL=                       # default model id for runs (provider-specific)
# WARDEN_CONCURRENCY=8                # max concurrent runs (Runs API)
# WARDEN_SERVICE_NAME=warden         # service name reported in telemetry
# WARDEN_DOTENV_DIR=                  # explicit dir to load .env from (else nearest ancestor)
# HITL_SLA_SECONDS=60                 # human-in-the-loop gate timeout before a run is held/expired

# ── Provider credentials (resolved server-side; never sent by callers) ─────────
# Prefer OAuth where available; API keys are the fallback lane.
# ANTHROPIC_API_KEY=                  # Claude SDK provider (API-key lane)
# CLAUDE_CODE_OAUTH_TOKEN=            # Claude SDK provider (OAuth lane, preferred)
# OPENAI_API_KEY=                     # Codex provider
# CODEX_HOME=                         # Codex auth/home dir
# CODEX_MODEL=                        # Codex model id
# WARDEN_CODEX_AUTH_SOURCE=           # where Codex auth is sourced from
# CODEX_ALLOW_UNGATED_CUSTOM_TOOLS=false   # allow Codex custom tools without the permission gate
# OPENHARNESS_BASE_URL=               # OpenHarness/Ollama base URL (e.g. http://localhost:11434)
# OPENHARNESS_MODEL=                  # OpenHarness/Ollama model id
# OPENHARNESS_API_KEY=                # OpenHarness API key (if the endpoint requires one)

# ── Managed keys (server-side credential registry, secrets-by-reference) ───────
# MANAGED_KEYS_JSON={"user:provider":"env:SOME_KEY_VAR"}   # inline registry (ref, not secret)
# MANAGED_KEYS_FILE=                  # path alternative to the inline JSON
# PRICING_JSON=                       # override model pricing table (JSON)

# ── Caller auth for the Runs API (empty registry ⇒ open, single-tenant dev) ────
# SERVICE_TOKENS_JSON={"my-app":"tok-abc123"}   # x-service-token → caller identity
# SERVICE_TOKENS_FILE=                # path alternative to the inline JSON
# AUTH_STORE_BACKEND=local            # local | postgres
# AUTH_STATE_DIR=                     # dir for the local auth store
# AUTH_OAUTH_ALLOWED_USERS=           # comma-separated allowlist (empty ⇒ all)
# AUTH_ON_OAUTH_DENIED=reject         # behavior when an OAuth user isn't allowed

# ── State / storage ────────────────────────────────────────────────────────────
# WARDEN_BASE_DIR=                    # in-container/base workspace root
# WARDEN_STATE_ROOT=                  # durable run/session state root
# WARDEN_STATE_BACKEND=local          # local | postgres  (postgres = multi-replica; needs --extra postgres)
# WARDEN_STORAGE_BACKEND=local        # local | s3
# WARDEN_POSTGRES_DSN=                # postgresql://user:pass@host:5432/db  (state_backend=postgres)
                                      #   falls back to DATABASE_URL if set
# WARDEN_SESSION_DB=                  # path to the local session DB (sqlite)
# RUN_REGISTRY_STORE_BACKEND=local    # local | postgres
# RUN_REGISTRY_STATE_DIR=             # dir for the local run registry
# CRASH_STORAGE_BACKEND=local         # where crash snapshots are stored

# ── S3 storage backend (only if WARDEN_STORAGE_BACKEND=s3) ─────────────────────
# AWS_BUCKET_NAME=                    # target bucket
# AWS_REGION=                         # (alias: AWS_DEFAULT_REGION)
# AWS_S3_ENDPOINT=                    # custom endpoint (e.g. MinIO); omit for AWS
# AWS_BUCKET_LOCATION=                # bucket location constraint on create
# AWS_ACCESS_KEY_ID=                  # (or AWS_ACCESS_KEY); prefer an instance role in prod
# AWS_SECRET_ACCESS_KEY=

# ── Resource governance (cost/time caps; the Governor) ─────────────────────────
# GOVERNANCE_ENABLED=true             # master switch
# GOVERNANCE_ALLOW_UNCAPPED=false     # allow runs with no cost cap
# GOVERNANCE_DEFAULT_COST_CAP_USD=    # per-run spend ceiling (USD)
# GOVERNANCE_DEFAULT_DEADLINE_S=      # per-run wall-clock deadline (seconds)
# GOVERNANCE_DEFAULT_MAX_TURNS=       # per-run turn cap
# GOVERNANCE_HARD_CAP_OUT=            # hard ceiling on output tokens
# GOVERNANCE_INPUT_TOKENS_EST=        # input-token estimate for pre-run reservation
# GOVERNANCE_LEDGER_BACKEND=local     # local | postgres
# GOVERNANCE_BALANCE_BACKEND=local    # local | postgres
# GOVERNANCE_STATE_DIR=               # dir for the local governance ledgers

# ── Safety (guardrails, classifiers, judges) ───────────────────────────────────
# SAFETY_JUDGE=                       # enable/select the LLM judge
# SAFETY_JUDGE_MODEL=                 # judge model id
# SAFETY_LLM_JUDGE_MODEL_ANTHROPIC=   # judge model when using Anthropic
# SAFETY_LLM_JUDGE_MODEL_OPENAI=      # judge model when using OpenAI
# SAFETY_DRIVEN_MODEL=                # model driving safety experiments
# SAFETY_DEBERTA_MODEL_ID=            # local DeBERTa classifier id (needs the ML extra)
# SAFETY_FUZZY_THRESHOLD=             # fuzzy-match threshold for leak detection
# SAFETY_STREAMING_BUFFER_SIZE=       # streaming output filter buffer size
# SAFETY_OLLAMA_BASE_URL=             # Ollama endpoint for the local safety classifier
# SAFETY_OLLAMA_MODEL=                # Ollama model for the local safety classifier

# ── Audit (the audit trail) ────────────────────────────────────────────────────
# AUDIT_ENABLED=false                 # record the per-run audit trail
# AUDIT_LOG_DIR=                      # dir for audit JSONL logs

# ── Telemetry (OPTIONAL, default OFF; needs `uv sync --extra telemetry`) ───────
# ENABLE_TELEMETRY=false
# CLAUDE_CODE_ENABLE_TELEMETRY=       # let the Claude SDK export its own OTEL
# LANGFUSE_PUBLIC_KEY=pk-lf-example
# LANGFUSE_SECRET_KEY=sk-lf-example
# LANGFUSE_HOST=http://localhost:3456
# LANGFUSE_TOOL_OUTPUT_LIMIT=         # truncate tool output captured in traces
# OTEL_COLLECTOR_ENDPOINT=http://localhost:4317   # (alias: OTEL_EXPORTER_OTLP_ENDPOINT)
# OTEL_SERVICE_NAME=warden
# TEMPO_URL=                          # Tempo query URL (for the observability guides)
